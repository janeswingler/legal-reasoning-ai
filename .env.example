# MariaDB / MySQL (local or university)
# Local example:
#   MYSQL_HOST=127.0.0.1
#   MYSQL_PORT=3306
#   MYSQL_USER=aillr
#   MYSQL_PASSWORD=your-local-password
#   MYSQL_DATABASE=aillr
# University (from aillr VM / stargate):
#   MYSQL_HOST=sql
#   MYSQL_USER=aillr
#   MYSQL_PASSWORD=...
#   MYSQL_DATABASE=aillr
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

PORT=3000

# Anthropic Claude (chat)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TITLE_MODEL=claude-haiku-4-5

# OpenAI (embeddings only — used for hybrid PDF retrieval)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Submission storage: drive (default), local, or both
SUBMISSION_STORAGE=drive
# SUBMISSIONS_DIR=./uploads/submissions

# Google Drive submission (personal Drive folders require OAuth)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_DRIVE_REFRESH_TOKEN=""
# Wrap the token in quotes — Google tokens contain // which dotenv treats as a comment.

# Student study URLs (frontend query params):
#   systemID=1 — Assignment Editor only (no AI)
#   systemID=2 — AI chat + Assignment Editor (default if omitted)
#   /?participantID=abc&assignment=week-01&systemID=1
#   /?participantID=abc&assignment=week-01&systemID=2

# After setting client ID/secret, visit http://localhost:3000/api/auth/google/setup once.

# Shared Drive only (Google Workspace) — not for personal "My Drive" folders:
# GOOGLE_DRIVE_USE_SERVICE_ACCOUNT=true
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json
