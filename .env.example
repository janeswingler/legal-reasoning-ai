# MariaDB / MySQL (local or university)
# Local example:
#   MYSQL_HOST=127.0.0.1
#   MYSQL_PORT=3306
#   MYSQL_USER=aillr
#   MYSQL_PASSWORD=your-local-password
#   MYSQL_DATABASE=aillr
# University (from aillr VM / stargate):
#   MYSQL_HOST=sql
#   MYSQL_USER=aillr
#   MYSQL_PASSWORD=...
#   MYSQL_DATABASE=aillr
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

PORT=3000

# Production (aillr VM): Alex places TLS certs in ./certs/ (cst.key, fullchain.pem).
# With certs present, the server listens with HTTPS on PORT; otherwise HTTP (local dev).

# Unused by the landing page. If set, students still receive an access cookie
# after entering a participant ID, so /app.html stays reachable.
ACCESS_PASSWORD=
# ACCESS_COOKIE_DAYS=7
# COOKIE_SECURE=true

# Anthropic Claude (chat)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TITLE_MODEL=claude-haiku-4-5

# OpenAI (embeddings only — used for hybrid PDF retrieval)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Submission storage: drive (default), local, or both
SUBMISSION_STORAGE=drive
# SUBMISSIONS_DIR=./uploads/submissions

# Assignment PDF fonts (optional)
# PDFs are rendered by headless Chrome. Put the Times New Roman TTFs
# (times.ttf, timesbd.ttf, timesi.ttf, timesbi.ttf) in server/assets/fonts/ so
# the PDF line breaks match the on-screen editor exactly. The files are not in
# the repo because they are licensed. Without them Chrome falls back to the
# system serif, which is correct on Windows and macOS.
# PLEADING_FONT_DIR=./server/assets/fonts

# Google Drive submission (personal Drive folders require OAuth)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_DRIVE_REFRESH_TOKEN=""
# Wrap the token in quotes — Google tokens contain // which dotenv treats as a comment.

# Post-task questionnaire (Qualtrics)
# Students never see this address directly: they go to /questionnaire/start,
# which appends participantID and memoID and forwards them here.
QUALTRICS_URL=https://myusf.usfca.edu/ets/educational-technologies/qualtrics
#
# Two things must be set up inside the Qualtrics survey itself:
#   1. Survey Flow → add Embedded Data fields named participantID and memoID,
#      left blank so they are populated from the query string.
#   2. Survey Options → End of Survey → Redirect to a URL:
#      https://aillr.cs.usfca.edu:3000/questionnaire/complete?participantID=${e://Field/participantID}&memoID=${e://Field/memoID}
#
# That redirect is what marks the questionnaire complete. A student who closes
# the tab on the final page is not recorded as finished and will be sent back
# to the survey the next time they open their assignment link.

# Student study URLs (one Canvas link per memo):
#   https://aillr.cs.usfca.edu:3000/?memoID=1
#   The landing page asks for participant ID only.
#
# Which system a participant sees for each memo comes from the condition
# mapping at server/data/participant-conditions.csv, exported from the study
# design spreadsheet (AI = system 2, NoAI = system 1). The server refuses to
# start if that file is missing or malformed, and a participant ID that is not
# in it cannot enter the study.
# PARTICIPANT_CONDITIONS_FILE=./server/data/participant-conditions.csv
#
# Entering a participant ID routes on assignment state:
#   writing in progress      → the editor
#   submitted, survey to do  → Qualtrics
#   both done                → the assignment complete page

# After setting client ID/secret, visit http://localhost:3000/api/auth/google/setup once.

# Shared Drive only (Google Workspace) — not for personal "My Drive" folders:
# GOOGLE_DRIVE_USE_SERVICE_ACCOUNT=true
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json
